# ScaleBridge Bio Environment Configuration (Root Example)

# Backend DB & Storage
DATABASE_URL=postgresql+psycopg://scalebridge:scalebridge@localhost:5432/scalebridge
# For zero-config local SQLite: sqlite:///./var/scalebridge.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

# S3 / MinIO Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scalebridge-files

# Security & Auth
JWT_SECRET_KEY=dev-only-secret-key-replace-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Network & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
PORT=8000
MAX_UPLOAD_MB=50

# Seed
SEED_DEMO_ON_STARTUP=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
