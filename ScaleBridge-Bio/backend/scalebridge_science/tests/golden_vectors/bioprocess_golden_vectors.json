{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Validated golden test vectors for ScaleBridge Bio scientific calculation engine (docs/11_SCALE_UP_CALCULATIONS.md §9, docs/18).",
  "vectors": [
    {
      "id": "T1",
      "name": "RPM to rev/sec conversion without radian error",
      "formula": "units.to_si_quantity",
      "inputs": {
        "agitation_speed_rpm": 60.0
      },
      "expected": {
        "value_si": 1.0,
        "unit_si": "1 / second",
        "display_value": 60.0,
        "display_unit": "rpm"
      },
      "tolerance": 1e-9
    },
    {
      "id": "T2",
      "name": "F-TIP-001 Impeller Tip Speed",
      "formula": "F-TIP-001",
      "inputs": {
        "N_rpm": 500.0,
        "D_m": 0.055
      },
      "expected": {
        "value_si": 1.4398966,
        "unit_si": "meter / second",
        "display_unit": "m/s",
        "evidence_level": "measured"
      },
      "tolerance": 1e-5
    },
    {
      "id": "T3",
      "name": "F-RE-001 Impeller Reynolds Number",
      "formula": "F-RE-001",
      "inputs": {
        "rho_kg_m3": 1000.0,
        "N_rpm": 500.0,
        "D_m": 0.055,
        "mu_Pa_s": 0.001
      },
      "expected": {
        "value_si": 25208.3333,
        "unit_si": "dimensionless",
        "regime": "turbulent",
        "evidence_level": "assumed"
      },
      "tolerance": 1e-4
    },
    {
      "id": "T4",
      "name": "F-VVM-001 Gas Flow per Liquid Volume",
      "formula": "F-VVM-001",
      "inputs": {
        "Q_g_L_min": 1.0,
        "V_w_L": 2.0
      },
      "expected": {
        "display_value": 0.5,
        "display_unit": "1/min (vvm)",
        "value_si": 0.008333333
      },
      "tolerance": 1e-6
    },
    {
      "id": "T5",
      "name": "F-PV-001 Power per Volume",
      "formula": "F-PV-001",
      "inputs": {
        "P_W": 10.0,
        "V_w_L": 2.0
      },
      "expected": {
        "value_si": 5000.0,
        "unit_si": "watt / meter ** 3",
        "display_unit": "W/m^3"
      },
      "tolerance": 1e-6
    },
    {
      "id": "T6",
      "name": "F-PWR-001 Ungassed Power from Power Number",
      "formula": "F-PWR-001",
      "inputs": {
        "Np": 5.0,
        "rho_kg_m3": 1000.0,
        "N_rpm": 500.0,
        "D_m": 0.055,
        "impeller_count": 1
      },
      "expected": {
        "value_si": 1.45626,
        "unit_si": "watt",
        "value_nature": "estimated"
      },
      "tolerance": 1e-4
    },
    {
      "id": "T7_T8",
      "name": "F-OTR-001 and F-DOC-001 Oxygen Transfer Rate and DO Concentration",
      "formula": "F-OTR-001",
      "inputs": {
        "kla_1_h": 100.0,
        "C_star_mmol_L": 0.20,
        "DO_percent": 30.0
      },
      "expected": {
        "C_L_display": 0.06,
        "C_L_unit": "mmol/L",
        "OTR_display": 14.0,
        "OTR_unit": "mmol/(L*h)",
        "OTR_max_display": 20.0
      },
      "tolerance": 1e-6
    },
    {
      "id": "T9",
      "name": "F-VS-001 Superficial Gas Velocity",
      "formula": "F-VS-001",
      "inputs": {
        "Q_g_L_min": 1.0,
        "T_m": 0.13
      },
      "expected": {
        "value_si": 0.0012557,
        "unit_si": "meter / second"
      },
      "tolerance": 1e-4
    },
    {
      "id": "T10_T11_T12",
      "name": "Scale-up Criteria S-TIP, S-PV, and S-VVM Benchmark (2L Lab to 150L Target)",
      "formula": "criteria.evaluate_criteria_and_calculations",
      "inputs": {
        "source_vessel_D_m": 0.055,
        "source_vessel_T_m": 0.13,
        "source_N_rpm": 500.0,
        "source_airflow_L_min": 1.0,
        "source_volume_L": 2.0,
        "target_vessel_D_m": 0.25,
        "target_vessel_T_m": 0.55,
        "target_volume_L": 150.0
      },
      "expected": {
        "S_TIP_target_N_rpm": 110.0,
        "S_PV_target_N_rev_s": 2.818,
        "S_PV_target_N_rpm": 169.08,
        "S_VVM_target_Qg_L_min": 75.0
      },
      "tolerance": 1e-3
    }
  ]
}
