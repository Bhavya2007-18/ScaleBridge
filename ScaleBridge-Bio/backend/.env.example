DATABASE_URL=sqlite:///./var/scalebridge.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://scalebridge:scalebridge@localhost:5432/scalebridge
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scalebridge-files
JWT_SECRET_KEY=replace-with-secure-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_ON_STARTUP=true
