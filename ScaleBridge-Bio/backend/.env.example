# ScaleBridge Bio Backend Environment Configuration
# Domain F Deliverable (Owner: Person 4 - Reporting, DevOps and Quality Lead)
# Copy to .env for local development. NEVER COMMIT REAL SECRETS TO GIT.

# Database Configuration
DATABASE_URL=sqlite:///./var/scalebridge.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://scalebridge:scalebridge@localhost:5432/scalebridge

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scalebridge-files

# Security & Authentication
# In production, generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-key-replace-in-production-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Boundaries & Safety
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO_ON_STARTUP=true
