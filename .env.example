# ScaleBridge Bio Environment Configuration Example
# Domain F Deliverable (Owner: Person 4 - Reporting, DevOps and Quality Lead)
# Copy to .env for local development. NEVER COMMIT REAL SECRETS TO GIT.

# Database Configuration
# Local SQLite for testing/development:
DATABASE_URL=sqlite:///./var/scalebridge.db
# Production PostgreSQL (Render / Docker):
# DATABASE_URL=postgresql+psycopg://scalebridge:scalebridge@localhost:5432/scalebridge

# Object Storage Abstraction (Local Disk vs MinIO/AWS S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

# S3 / MinIO Configuration (Required if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scalebridge-files

# Security & Authentication
# Generate a cryptographically secure 32+ byte key with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-key-replace-in-production-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion & Upload Boundaries
MAX_UPLOAD_MB=50

# Cross-Origin Resource Sharing (CORS) - Comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seeding & Demo Data
SEED_DEMO_ON_STARTUP=true
